{
  "size": 0,
  "query": {
    "bool": {
      "filter": [
        {
          "range": {
            "@timestamp": {
              "gte": "now-9d/d",
              "lt": "now-8d/d"
            }
          }
        }
      ]
    }
  },
  "aggs": {
    "hourly": {
      "date_histogram": {
        "field": "@timestamp",
        "fixed_interval": "1h",
        "min_doc_count": 1
      },
      "aggs": {
        "latency": {
          "percentiles": {
            "field": "es.search_response.took_durations.query.histogram",
            "percents": [90, 95, 99]
          }
        }
      }
    },
    "p90_stats": {
      "extended_stats_bucket": {
        "buckets_path": "hourly>latency[90.0]"
      }
    },
    "p95_stats": {
      "extended_stats_bucket": {
        "buckets_path": "hourly>latency[95.0]"
      }
    },
    "p99_stats": {
      "extended_stats_bucket": {
        "buckets_path": "hourly>latency[99.0]"
      }
    }
  }
}
